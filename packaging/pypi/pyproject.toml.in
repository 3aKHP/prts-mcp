[build-system]
requires = ["hatchling==1.33.0"]
build-backend = "hatchling.build"

[project]
name = "prts-mcp"
version = "@VERSION@"
description = "Arknights fan-creation MCP server with native Rust runtime"
readme = "README.md"
requires-python = ">=3.11"
license = "MIT"
license-files = ["LICENSE", "NOTICE", "licenses/**/*"]
authors = [{name = "3aKHP"}]
keywords = ["mcp", "arknights", "prts", "mcp-server"]

[project.urls]
Homepage = "https://github.com/3aKHP/prts-mcp"
Repository = "https://github.com/3aKHP/prts-mcp"
"Bug Tracker" = "https://github.com/3aKHP/prts-mcp/issues"

[project.scripts]
prts-mcp = "prts_mcp.server:main"
prtsctl = "prts_mcp.server:management_main"

[tool.hatch.build.targets.wheel]
packages = ["prts_mcp"]

[tool.hatch.build.hooks.custom]
