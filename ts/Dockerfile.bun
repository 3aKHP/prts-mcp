FROM oven/bun:1.3.14-alpine AS builder

WORKDIR /build

# Install dependencies first (layer cache). Bun is a supported optional runtime;
# npm remains the default package manager and publishing path.
COPY ts/package.json ts/bun.lock ./
RUN bun install --frozen-lockfile

# Compile TypeScript
COPY ts/tsconfig.json ./
COPY ts/src/ src/
RUN bun run build

# ---------------------------------------------------------------------------
FROM oven/bun:1.3.14-alpine AS runtime

WORKDIR /app

# Production dependencies only
COPY ts/package.json ts/bun.lock ./
RUN bun install --frozen-lockfile --production

# Compiled JS
COPY --from=builder /build/dist ./dist

# Bundled game data baked in at build time (pre-fetched by CI via
# python/scripts/fetch_gamedata.py or ts equivalent).
# Serves as a read-only offline fallback when /data/gamedata has no data yet.
COPY data/ data/

# Tell config.ts we are running inside Docker so it uses /data/gamedata
# (the volume mount-point) as the auto-sync target.
ENV PRTS_MCP_ROOT=/app
ENV PORT=3000

# Create the volume mount-point as an empty directory.
RUN mkdir -p /data/gamedata /data/gamedata-levels /data/storyjson

EXPOSE 3000

ENTRYPOINT ["bun", "dist/server-bun.js"]
