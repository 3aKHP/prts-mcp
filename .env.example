# PRTS-MCP runtime environment example.
# Note: The server reads process environment variables directly and does NOT auto-load .env files.
# Pass only the variables you need via your shell, systemd unit, Docker (-e / --env-file), or MCP client config.

# Optional GitHub API token (reduces anonymous rate-limiting) and comma-separated fallback mirror URLs:
GITHUB_TOKEN=
GITHUB_MIRRORS=

# Optional compatible GitHub data/image source (owner/repo; empty uses the default below).
# Custom sources use separate sources/<owner>/<repo>/ directories; existing explicit sync
# directories must be empty on first use. Local file overrides keep their existing behavior.
# PRTS_DATA_SOURCE_REPO=3aKHP/arknights-data-pipeline

# Background release check interval in seconds (valid range: 60..604800).
# Setting 0 disables periodic polling but still runs the initial check on startup.
PRTS_AUTO_SYNC_INTERVAL_SECONDS=3600

# Game-data backend (3.1 defaults to json; SQLite is opt-in and experimental).
# The backend is fixed at startup. Only the selected backend downloads and caches data.
# PRTS_DATA_BACKEND=sqlite
# Validation: normal reuses structure checks after matching the full-file checksum; strict rechecks on restart.
# PRTS_VALIDATION_MODE=normal
# PRTS_DATA_DIR=/path/to/database
# A non-empty PRTS_DATA_DB selects SQLite when the backend is unset, and disables game-data sync.
# PRTS_DATA_DB=/path/to/zh_CN.sqlite
# Official 3.1 packages retain the JSON fallback; offline SQLite needs a precompiled DB.

# Optional custom local data paths. Keep these UNSET (commented out) to use default paths and auto-sync.
# In JSON mode, setting GAMEDATA_PATH (even to an empty value) disables gamedata/levels auto-sync.
# Setting a non-empty STORYJSON_PATH disables story auto-sync.
# GAMEDATA_PATH=/path/to/ArknightsGameData
# STORYJSON_PATH=/path/to/zh_CN.zip
# PRTS_IMAGE_DIR=/path/to/images

# Transport mode:
# - Native binary / npm `prts-mcp`: defaults to `http`; set `PRTS_TRANSPORT=stdio` for local stdio clients.
# - Docker image (`prts-mcp-ghcr`): defaults to `stdio`; set `PRTS_TRANSPORT=http` for HTTP deployment.
# - Legacy compatibility commands (`prts-mcp-ts*`): keep fixed transport modes and ignore PRTS_TRANSPORT.
# PRTS_TRANSPORT=stdio
HOST=0.0.0.0
PORT=3000

# MCP output channel: `content` (default Markdown), `structured`, or `both`.
# In HTTP mode, clients can also override this via `?output_channel=` or `x-prts-output-channel`.
PRTS_OUTPUT_CHANNEL=content

# Operator artwork tool (`operator_artwork`):
# - `LOCAL_IMAGE=false` (default): fetches requested images on demand from PRTS MediaWiki with an in-memory LRU cache.
# - `LOCAL_IMAGE=true`: syncs full AKDP PNG packages (multi-GB) to local disk; `ORIGINAL_IMAGE=true` adds unscaled originals.
IMAGES_ENABLED=true
LOCAL_IMAGE=false
ORIGINAL_IMAGE=false
PRTS_IMAGE_CACHE=true

# Optional local diagnostics (`/debug/cache` and `/debug/metrics`).
# Disabled (returns 404) when PRTS_DEBUG_TOKEN is unset. Keep your token private.
# PRTS_DEBUG_TOKEN=replace-with-your-private-token
PRTS_METRICS_ENABLED=false
# SESSION_IDLE_TIMEOUT_MS=86400000
