{
  "mcpServers": {
    "prts_wiki_docker": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-v", "prts-data:/data", "ghcr.io/3akhp/prts-mcp:3.2.4"]
    },
    "prts_wiki_npm_stdio": {
